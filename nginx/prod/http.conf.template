# ---------------------------------------------------------------------------
# RetroGPT production edge proxy — HTTP only (Issue #26).
#
# Rendered by the nginx image entrypoint at container start: ${DOMAIN} is
# substituted from the environment (envsubst).
#
#   /            -> frontend   (static SPA served by the frontend image)
#   /api/*       -> api-gateway
#   /api/chat/stream -> api-gateway with response buffering disabled (SSE)
#
# For HTTPS use https.conf.template after running deploy/init-letsencrypt.sh.
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream frontend {
    server frontend:80;
}

upstream api_gateway {
    server api-gateway:4000;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Request body limit — the gateway enforces its own 1 MB limit too.
    client_max_body_size 1m;

    # Baseline security headers.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Let's Encrypt ACME HTTP-01 challenge (served from certbot's webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # --- API ---------------------------------------------------------------
    # Server-Sent Events endpoint (Issue #25). Exact match so token frames
    # are flushed to the client as they arrive instead of being buffered.
    location = /api/chat/stream {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /api/ {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --- Frontend ----------------------------------------------------------
    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
