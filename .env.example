# --- LLM / Embeddings ---
LLM_PROVIDER=gemini                # gemini | openai
LLM_MODEL=gemini-1.5-flash         # e.g. a current Gemini Flash model name
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004 # e.g. a current Gemini embedding model name
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Vector DB ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=retro_games

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# --- Gateway ---
PORT=4000
AI_SERVICE_URL=http://ai-service:8000
API_KEY=change-me
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo:27017/retrogpt
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MIN=30
