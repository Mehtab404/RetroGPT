# --- LLM / Embeddings ---
LLM_PROVIDER=groq                # gemini | openai | groq
LLM_MODEL=openai/gpt-oss-120b       # provider's model: gemini-1.5-flash | gpt-4o-mini | openai/gpt-oss-120b
EMBEDDING_PROVIDER=fastembed        # gemini | openai | fastembed (local ONNX, no API key)
EMBEDDING_MODEL=text-embedding-004 # model name for gemini/openai (ignored by fastembed)
# GOOGLE_API_KEY=
# OPENAI_API_KEY
GROQ_API_KEY=                     # required when LLM_PROVIDER=groq — https://console.groq.com/keys
# fastembed options (used when EMBEDDING_PROVIDER=fastembed)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=/data/fastembed_cache

# --- Vector DB ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=retro_games
# Must match the embedding model: 768 gemini text-embedding-004,
# 1536 openai text-embedding-3-small, 384 fastembed BAAI/bge-small-en-v1.5.
VECTOR_SIZE=384

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# --- Hybrid search (dense + BM25 via RRF) ---
HYBRID_SEARCH_ENABLED=true
HYBRID_PREFETCH_K=20
BM25_STATS_PATH=/data/bm25_stats.json

# --- Cross-encoder re-ranking ---
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CACHE_DIR=/data/fastembed_cache

# --- Agent mode (POST /agent on the AI service) ---
# Default tool-calling turn budget; requests may override it (1-6).
AGENT_DEFAULT_MAX_STEPS=3

# --- Gateway ---
PORT=4000
AI_SERVICE_URL=http://ai-service:8000
API_KEY=change-me
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo:27017/retrogpt
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MIN=30

# --- Logging ---
# JSON log verbosity for both services: debug | info | warn | error
LOG_LEVEL=info
