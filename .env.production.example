# ---------------------------------------------------------------------------
# Production secrets & settings for docker-compose.prod.yml (Issue #26).
#
# Copy to .env.production on the deployment host and fill in the real values.
# Never commit the real file — on AWS keep it in SSM Parameter Store.
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ---------------------------------------------------------------------------

# --- Public routing ---------------------------------------------------------
# Domain served by the edge Nginx (your domain, or the EC2 public DNS name).
DOMAIN=demo.example.com
# Browser origin allowed by the gateway's CORS policy (usually https://<DOMAIN>).
PUBLIC_ORIGIN=https://demo.example.com

# --- Images -----------------------------------------------------------------
# ECR registry host, e.g. 123456789012.dkr.ecr.eu-central-1.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com
# Git SHA pushed by CI (or "latest").
IMAGE_TAG=latest

# --- Application secrets ----------------------------------------------------
# Public demo key the frontend sends as x-api-key (long random string).
API_KEY=change-me-to-a-long-random-string
# LLM provider keys. Set the key(s) for the provider(s) you use:
#   gemini: GOOGLE_API_KEY (default LLM + embeddings)
#   groq:   GROQ_API_KEY   (LLM only — Groq has no embeddings API)
#   openai: OPENAI_API_KEY (LLM and/or embeddings)
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# URL-safe passwords (embedded in connection strings).
REDIS_PASSWORD=change-me-url-safe
MONGO_USER=retrogpt
MONGO_PASSWORD=change-me-url-safe

# --- Optional tuning --------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# Must match the embedding model: 768 gemini, 1536 openai text-embedding-3-small,
# 384 fastembed BAAI/bge-small-en-v1.5 (set EMBEDDING_PROVIDER=fastembed for
# key-free local embeddings).
VECTOR_SIZE=768
AI_WORKERS=2
LOG_LEVEL=info
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MIN=30

# --- Nginx ------------------------------------------------------------------
# HTTP-only by default. After deploy/init-letsencrypt.sh issued a certificate,
# switch to the HTTPS template:
#NGINX_CONF_FILE=./nginx/prod/https.conf.template
